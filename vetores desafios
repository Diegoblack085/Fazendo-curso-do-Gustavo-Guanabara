        escreval("============================")
        escreval("ALUNO ",C,": ")
        escreval("============================")
        escreva("Nome: ")
        LEIA(nome[c])
         para J <- 1 ate 5 faca
         escreval("Respostadas dadas: ")
         escreva("questão" ,J,": ")
         leia(resp[J])
           se (resp[J] = gab[J])entao
            pontOS <- pontos + 2
           fimse
                  PONTAL[C] <- PONTOS
       NOMEAL[C]  <- NOME[C]
        fimpara
