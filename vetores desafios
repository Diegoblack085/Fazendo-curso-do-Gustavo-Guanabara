DESAFIO 1
Algoritmo "semnome"

Var
   times : vetor[1..3]de caractere
   conf2 : vetor [1..3] de caractere
   conf1 : vetor [1..3] de caractere
   c,j : inteiro
Inicio
      para c <- 1 ate 3 faca
           escreval("Time: ")
           leia(times[c])
      fimpara
                         ESCREVAL("O CONFRONTE SERA:")
                   ESCREVAL("====================")
      para c <- 1 ate 3 faca
           para j <- 3 ate 1 passo -1 faca
           se (times[c] = times[j] )entao
              SENAO
                   escrevaL( times[c] ," X ", times[j])
           fimse
      fimpara
             fimpara
Fimalgoritmo
