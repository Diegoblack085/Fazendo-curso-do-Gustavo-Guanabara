Algoritmo "semnome"

Var
   c,r,L,r1: inteiro
   M: VETOR[1..3,1..3]DE inteiro
Inicio
r <- 1

    PARA C <- 1 ATE 3 FACA
         PARA L <- 1 ATE 3 FACA
              ESCREVA("DIGITE UM VALOR [",C,L,"]: ")
              LEIA(M[C,L])
         FIMPARA
    FIMPARA
    limpatela
    enquanto (r = 1) ou (r = 2)ou (r = 3)ou (r = 4)faca
    escreval("[1] MOSTRAR A MATRIZ:")
    escreval("[1] MOSTRAR A DIAGONAL PRINCIPAL:")
    escreval("[1] MOSTRAR O TRIANGULO SUPERIOR:")
    escreval("[4] MOSTRAR O TRIANGULO INFERIOR:")
    escreval("[5] SAIR: ")
    LEIA(r)
    limpatela
    SE (R = 1)ENTAO
      PARA C <-1 ATE 3 FACA
         PARA L <- 1 ATE 3 FACA
              ESCREVA(M[C,L])
         FIMPARA
                ESCREVAL()
      FIMPARA
             senao
                  se (r  = 2)entao
                     para c <- 1 ate 3 faca
                          para l <- 1 ate 3 faca
                          se(c = l)entao
                               escreva(m[c,l]:6)
                          fimse
                     fimpara
                          escreval()
                     fimpara
                  fimse
    FIMSE
    fimenquanto
Fimalgoritmo
